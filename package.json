{
  "name": "pawchive-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A native desktop and mobile client for the Pawchive archive",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "ios": "sh scripts/ios.sh dev",
    "ios:open": "sh scripts/ios.sh dev --open",
    "ios:build": "sh scripts/ios.sh build",
    "android": "sh scripts/android.sh",
    "android:init": "sh scripts/android.sh init",
    "android:dev": "sh scripts/android.sh dev",
    "android:build": "sh scripts/android.sh build",
    "android:bundle": "sh scripts/android.sh bundle",
    "android:run": "sh scripts/android.sh run",
    "android:emulator": "sh scripts/android.sh emulator",
    "android:doctor": "sh scripts/android.sh doctor",
    "android:clean": "sh scripts/android.sh clean",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "license": "MIT",
  "author": "Pawchive Desktop Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tplw/Pawchive-Client.git"
  },
  "homepage": "https://github.com/tplw/Pawchive-Client#readme",
  "bugs": {
    "url": "https://github.com/tplw/Pawchive-Client/issues"
  }
}
