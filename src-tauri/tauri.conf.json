{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawchive",
  "version": "1.0.6",
  "identifier": "pw.pawchive.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pawchive",
        "width": 1440,
        "height": 920,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; media-src 'self' https: blob: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Browse and play the Pawchive archive",
    "longDescription": "Pawchive is a native client for the Pawchive archive with creator discovery, search, a local library, downloads, and an integrated audio and video player.",
    "copyright": "© 2026 Pawchive Client Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": {
        "depends": [],
        "recommends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugins-ugly",
          "gstreamer1-libav"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "bundleVersion": "1.0.6",
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "nsis": { "installMode": "both" }
    }
  }
}
